{
  "expo": {
    "name": "Number Nova",
    "slug": "number-nova",
    "version": "0.2.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "scheme": "numbernova",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#02031A"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.guy16510.numbernova",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIRequiresFullScreen": true,
        "NSMotionUsageDescription": "Allow Number Nova to use motion so the player can steer the spaceship."
      }
    },
    "android": {
      "package": "com.guy16510.numbernova",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#02031A"
      },
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Number Nova to use motion so the player can steer the spaceship."
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE_LEFT"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 800,
          "resizeMode": "contain",
          "backgroundColor": "#02031A"
        }
      ]
    ]
  }
}
