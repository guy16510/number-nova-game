{
  "name": "number-nova",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "generate:sfx": "node scripts/generate-sfx.mjs",
    "postinstall": "npm run generate:sfx",
    "prestart": "npm run generate:sfx",
    "start": "expo start --go --clear",
    "start:go": "npm run generate:sfx && expo start --go",
    "start:go:clear": "npm run generate:sfx && expo start --go --clear",
    "start:dev-client": "npm run generate:sfx && expo start --dev-client",
    "start:dev-client:clear": "npm run generate:sfx && expo start --dev-client --clear",
    "android": "npm run generate:sfx && expo run:android",
    "ios": "npm run generate:sfx && expo run:ios",
    "ios:device": "npm run generate:sfx && expo run:ios --device",
    "ios:prebuild": "npm run generate:sfx && expo prebuild --platform ios --clean",
    "ios:eas:development": "npm run generate:sfx && npx eas-cli@latest build --platform ios --profile development",
    "ios:eas:preview": "npm run generate:sfx && npx eas-cli@latest build --platform ios --profile preview",
    "ios:eas:register-device": "npx eas-cli@latest device:create",
    "doctor": "npx expo-doctor@latest",
    "verify:ios": "node scripts/verify-ios-config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "simulate": "tsx scripts/simulate-game.ts --seeds 300 --frames 900 --solver-seeds 75 --report artifacts/simulation-report.json",
    "validate": "npm run generate:sfx && npm run verify:ios && npm run typecheck && npm test && npm run simulate",
    "export:android": "npm run generate:sfx && expo export --platform android --output-dir dist/android",
    "export:ios": "npm run generate:sfx && expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.36",
    "expo-av": "~16.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-haptics": "~15.0.8",
    "expo-screen-orientation": "~9.0.9",
    "expo-sensors": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
